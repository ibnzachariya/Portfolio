# Copy this file to .env for local use. On your host, add these as environment variables.

# Required: any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=a8367bbe0cbfc34b09c62e1352fed32d271420c5439f6d81d9366d87a2b54771

# Set to 1 only on your own computer. Never in production.
FLASK_DEBUG=0

# --- Contact form delivery: fill in ONE of the two options ---

# Option A (easiest, works on every host): free Formspree form.
# Sign up at formspree.io, create a form, copy the ID from https://formspree.io/f/<ID>
FORMSPREE_ID=xqpawkna

# Option B: send through your Gmail with an App Password
# (Google Account > Security > 2-Step Verification > App passwords).
# Note: some free hosts block outgoing email ports — use Formspree there.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TO=
